<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <title>DiwaliHaat - You're Invited!</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #FFF8F0;
      font-family: Arial, Helvetica, sans-serif;
      color: #292929;
    }

    .wrapper {
      width: 100%;
      padding: 30px 12px;
      box-sizing: border-box;
    }

    .invitation {
      max-width: 560px;
      margin: 0 auto;
      background: #FFFFFF;
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid #F1DED0;
      box-shadow: 0 8px 30px rgba(80, 40, 15, 0.08);
    }

    .hero {
      text-align: center;
      padding: 36px 20px 30px;
      color: #FFFFFF;
      background: linear-gradient(135deg, #8D270D, #B64216, #D86B25);
    }

    .diyas {
      font-size: 30px;
      letter-spacing: 8px;
      margin-bottom: 18px;
    }

    .eyebrow {
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 4px;
      margin-bottom: 12px;
      color: #FFE4B5;
    }

    .brand {
      font-size: 38px;
      line-height: 1.2;
      font-weight: 800;
      margin: 0;
      letter-spacing: 1px;
    }

    .tagline {
      font-size: 15px;
      margin: 12px 0 0;
      color: #FFF0DD;
      line-height: 1.6;
    }

    .content {
      padding: 32px 28px;
      text-align: center;
    }

    .greeting {
      font-size: 23px;
      color: #9C3516;
      margin: 0 0 14px;
    }

    .description {
      font-size: 15px;
      line-height: 1.8;
      color: #666666;
      margin: 0 0 24px;
    }

    .email-box {
      background: #FFF8F0;
      border: 1px solid #F0D8C6;
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 22px;
      text-align: left;
    }

    .label {
      font-size: 11px;
      font-weight: bold;
      color: #8A817A;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .email {
      font-size: 15px;
      font-weight: bold;
      color: #B64216;
      overflow-wrap: anywhere;
    }

    .otp-box {
      background: #FFFAF3;
      border: 2px dashed #DDA65E;
      border-radius: 14px;
      padding: 22px 12px;
      margin: 20px 0;
    }

    .otp-heading {
      color: #76513A;
      font-size: 13px;
      font-weight: bold;
      margin: 0 0 14px;
    }

    .otp {
      font-size: 34px;
      font-weight: 800;
      letter-spacing: 8px;
      color: #B64216;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .expiry {
      color: #777777;
      font-size: 12px;
      line-height: 1.7;
      margin-top: 14px;
    }

    .notice {
      background: #FFF1E5;
      border-radius: 10px;
      padding: 14px;
      color: #8D3B1B;
      font-size: 13px;
      line-height: 1.7;
      text-align: left;
      margin-top: 22px;
    }

    .footer {
      background: #FCF4EC;
      padding: 23px 20px;
      text-align: center;
      border-top: 1px solid #F1E2D5;
    }

    .footer-message {
      color: #9C3516;
      font-size: 15px;
      font-weight: bold;
      margin: 0 0 9px;
    }

    .footer-small {
      color: #888888;
      font-size: 11px;
      line-height: 1.7;
      margin: 0;
    }

    @media screen and (max-width: 480px) {
      .wrapper {
        padding: 14px 8px;
      }

      .content {
        padding: 26px 18px;
      }

      .brand {
        font-size: 32px;
      }

      .otp {
        font-size: 27px;
        letter-spacing: 5px;
      }
    }
  </style>
</head>

<body>
  <div class="wrapper">
    <div class="invitation">

      <div class="hero">
        <div class="diyas">🪔 ✨ 🪔</div>

        <div class="eyebrow">YOU'RE INVITED</div>

        <h1 class="brand">DiwaliHaat</h1>

        <p class="tagline">
          Celebrate the Festival of Lights
        </p>
      </div>

      <div class="content">
        <h2 class="greeting">Namaste, <%= name || "Friend" %>!</h2>

        <p class="description">
          We're delighted to welcome you to <strong>DiwaliHaat</strong>,
          a celebration of festive spirit, traditions, and togetherness.
          Use the verification code below to confirm your email address
          and continue your registration.
        </p>

        <div class="email-box">
          <div class="label">Registered Email Address</div>
          <div class="email"><%= email %></div>
        </div>

        <div class="otp-box">
          <p class="otp-heading">YOUR EMAIL VERIFICATION CODE</p>

          <p class="otp"><%= otp %></p>

          <p class="expiry">
            This code expires in <strong><%= expiryMinutes || 10 %> minutes</strong>.
            Please do not share it with anyone.
          </p>
        </div>

        <div class="notice">
          <strong>Important:</strong> If you did not request this
          verification code, you can safely ignore this email.
          Never share your OTP with anyone.
        </div>
      </div>

      <div class="footer">
        <p class="footer-message">
          Wishing you a bright and joyful Diwali! 🪔
        </p>

        <p class="footer-small">
          Thank you for being a part of DiwaliHaat.<br>
          This is an automated email. Please do not reply.
        </p>
      </div>

    </div>
  </div>
</body>
</html>